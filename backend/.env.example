# --- Database & cache ---
DATABASE_URL=postgresql+psycopg2://wa:wa@postgres:5432/wablast
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-admin-awal

# --- AI (opsional; tanpa ini ai-extract fallback graceful) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- WhatsApp resmi: Meta Cloud API (opsional; tanpa ini mode dry-run) ---
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=

# --- WhatsApp non-resmi: Baileys sidecar (opsional; kosong = dry-run) ---
# Di docker-compose, isi dengan http://baileys:3001 (service sidecar).
# Pairing: buka http://localhost:3001/qr lalu scan QR dari HP testing.
BAILEYS_API_URL=
# Opsional: kunci API sidecar (disarankan diisi; harus sama dengan BAILEYS_API_KEY service baileys)
BAILEYS_API_KEY=

# --- Frontend ---
FRONTEND_ORIGINS=http://localhost:5173
